# Reitti Overlay extension configuration.
# Copy this file to .env and run: node --env-file=.env src/server.js
# Every value can also be provided as a normal environment variable.

PORT=8090
HOST=0.0.0.0
DATA_DIR=./data

# Optional. Leave unset when Reitti reaches the extension by a service name or
# when the extension is served under a path prefix; the manifest then uses
# relative URLs that Reitti resolves against the registered manifest URL.
# PUBLIC_BASE_URL=https://maps.example.com/reitti

# Must be unique across all map extensions registered in Reitti. Change this if
# you run more than one instance.
EXTENSION_ID=reitti-overlays
EXTENSION_NAME=Reitti Overlays
LAYER_ID=overlays
LAYER_NAME=Overlays

# Default IANA time zone for new overlays. Each overlay can override it in the UI.
DEFAULT_TIMEZONE=Europe/Berlin

# Poll interval. Reitti caches polling data for min(interval, 30 s).
POLL_INTERVAL_MS=15000

# Layer placement and fallback style (used only until a track supplies its own
# per-feature lineColor/lineWidth).
MIN_ZOOM=0
Z_INDEX=0
PLACEMENT=below-paths
LINE_COLOR="#d9a441"
LINE_WIDTH=3

# Basemap for the admin preview only (not used by Reitti).
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# Extra origins the browser may load tiles, glyphs and sprites from. The style
# origin is allowed automatically; the default CARTO style serves its tiles
# from tiles.basemaps.cartocdn.com.
MAP_TILE_ORIGINS=https://tiles.basemaps.cartocdn.com

# Limits.
MAX_UPLOAD_BYTES=20971520
MAX_RESPONSE_BYTES=5242880

LOG_LEVEL=info
