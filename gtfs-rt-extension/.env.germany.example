# Unified Germany transit extension defaults.
# The Docker image copies this file to /app/.env and uses it at startup.
# Environment variables passed with `docker run -e` or compose `environment`
# override values from this file.

FEED_TYPE=germany
PORT=8090
# PUBLIC_BASE_URL is optional. When unset, the manifest uses relative URLs and
# Reitti resolves them against the registered manifest URL.
# PUBLIC_BASE_URL=http://localhost:8090

GTFS_RT_URL=https://realtime.gtfs.de/realtime-free.pb
GTFS_STATIC_URL=https://download.gtfs.de/germany/free/latest.zip

# Estimated coverage: all of Germany.
BBOX=5.5,47.0,15.5,55.5

# Live city coverage. These feeds are started only when their viewport is
# requested at or above LIVE_CITY_MIN_ZOOM, and stop after the idle timeout.
BERLIN_BBOX=13.20,52.35,13.65,52.65
MUNSTER_BBOX=7.45,51.80,7.80,52.15
LIVE_CITY_MIN_ZOOM=10
LIVE_CITY_IDLE_TIMEOUT_MS=600000

# VBB caps one radar response at 1,000 movements regardless of this value.
# TRANSPORT_REST_RESULTS=10000

# Optional comma-separated GTFS agency IDs.
# AGENCY_ID=agency-one,agency-two

STALE_AFTER_SECONDS=180
# Realtime requests use ETag/Last-Modified; unchanged feeds cost headers only.
REFRESH_INTERVAL_MS=15000
ESTIMATED_REFRESH_INTERVAL_MS=15000
ESTIMATED_POSITION_REFRESH_INTERVAL_MS=15000

# The GTFS.de archive is large; keep this directory on a mounted volume.
# Relative paths resolve against the working directory. In the Docker image
# this is /app/data/gtfs-static; locally it is ./data/gtfs-static.
STATIC_REFRESH_INTERVAL_MS=300000
STATIC_CACHE_DIR=data/gtfs-static

# Optional regional GTFS feeds with shapes.txt, loaded on demand when the
# map viewport intersects the region. The default registry is regions.json.
# REGIONS_FILE=regions.json
REGION_SHAPES_MIN_ZOOM=10
REGION_SHAPES_IDLE_TIMEOUT_MS=600000
# REGION_SHAPES_REFRESH_INTERVAL_MS=86400000

# Optional. When set, manifest and vehicle endpoints require
# Authorization: Bearer <key>.
# EXTENSION_API_KEY=replace-with-a-long-random-token
